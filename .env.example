# Copy this file to ".env" and fill in your own PostgreSQL password.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=put-your-postgres-password-here
PGDATABASE=broker_portal

# Port the portal opens on: http://localhost:3000
PORT=3000
# Any long random text. Keeps logins secure.
SESSION_SECRET=change-this-to-any-long-random-text
